id "pnggroup/libpng"

fromVer "1.0.0"

onRequire (proj, dep) => {
	// You should use zlib 1.0.4 or later to run this
	dep.require "madler/zlib", "1.2.11"
}

onBuild ctx => {
	installDir := ctx.outputDir

	a := autotools.new(ctx.SourceDir, ctx.SourceDir+"/_build", installDir)

	for _, dep := range ctx.Proj.Deps {
		depDir := ctx.outputDir(dep)
		a.use depDir
	}
	a.configure
	a.build
	a.install
}
